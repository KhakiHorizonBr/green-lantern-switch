+  length = std::min(length, kBufferSize - start);
+  size_t page_first = start >> page_size_log2_;
+  size_t page_last = (start + length - 1) >> page_size_log2_;
+  uint64_t seq = 0;
+  for (size_t page = page_first; page <= page_last; ++page) {
+    seq = std::max(seq, page_write_seq_[page]);
