+      "gpu_native_stats: resolve destination 0x{:08X} + 0x{:X} bytes ({} unique so far, "
+      "vertex-range overlap: {})",
+      start, length, s.resolve_ranges.size(), hits_vertex_data ? "YES" : "no");
+}
+
+void EndFrame(int64_t cp_drain_us) {
+  State& s = state();
