+        rex::bit_count(s.vertex_pages[i] & s.texture_pages[i]));
+  }
+
+  PERF_counter_set(kNativeUniqueVertexBytes, s.unique_vertex_bytes);
+  PERF_counter_set(kSharedPageOverlaps, static_cast<int64_t>(overlap_pages));
