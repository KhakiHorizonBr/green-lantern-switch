+bool SharedMemory::UploadRangeUnwatched(uint32_t guest_offset, uint32_t size,
+                                        const void* host_src, uint64_t* write_seq_out) {
+  if (!size) {
+    return true;
+  }
+  if (host_src == nullptr || guest_offset > kBufferSize || (kBufferSize - guest_offset) < size) {
+    return false;
+  }
+  // Sparse backing is bound per allocation, not per page, so the destination
+  // can have no memory behind it at all if the emulated path has never
+  // requested anything in it - the native path skips RequestRanges, which is
+  // where this normally happens.
+  if (!EnsureHostGpuMemoryAllocated(guest_offset, size)) {
+    return false;
+  }
+  // Deliberately no MakeRangeValid: the range stays exactly as valid, or as
+  // invalid, as it was, and no watch is armed for it.
+  if (!UploadRangeUnwatchedImpl(guest_offset, size, host_src)) {
+    // A mid-range staging failure leaves part of the range written, so the
+    // pages are still stamped - the caller drops its claim on this range, but
+    // every other window overlapping it has to notice the bytes moved.
+    StampWrittenPages(guest_offset, size);
+    return false;
+  }
+  // Stamped after the copy is recorded, so the sequence handed back orders
+  // exactly like the copy does in the command stream: a window whose recorded
+  // sequence is the newest over its pages is the last thing written there.
+  uint64_t seq = StampWrittenPages(guest_offset, size);
+  if (write_seq_out) {
+    *write_seq_out = seq;
+  }
+  PERF_counter_add(kNativeBytesUploaded, size);
+  return true;
+}
