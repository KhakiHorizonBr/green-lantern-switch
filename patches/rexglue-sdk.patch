+bool VulkanDevice::GetMemoryBudget(VkDeviceSize* usage, VkDeviceSize* budget) const {
+  if (!usage || !budget || !extensions_.ext_EXT_memory_budget) return false;
+  const VulkanInstance::Functions& ifn = vulkan_instance_->functions();
+  if (!ifn.vkGetPhysicalDeviceMemoryProperties2) return false;
+
+  VkPhysicalDeviceMemoryBudgetPropertiesEXT budget_properties{};
+  budget_properties.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT;
+  VkPhysicalDeviceMemoryProperties2 properties{};
+  properties.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2;
+  properties.pNext = &budget_properties;
+  ifn.vkGetPhysicalDeviceMemoryProperties2(physical_device_, &properties);
+
+  VkDeviceSize total_usage = 0;
+  VkDeviceSize total_budget = 0;
+  for (uint32_t heap = 0; heap < properties.memoryProperties.memoryHeapCount; ++heap) {
+    total_usage += budget_properties.heapUsage[heap];
+    total_budget += budget_properties.heapBudget[heap];
+  }
+  *usage = total_usage;
+  *budget = total_budget;
+  return true;
+}
