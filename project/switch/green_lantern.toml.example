# Copie este arquivo para a mesma pasta do NRO e renomeie para green_lantern.toml.
# O ReXGlue lê este TOML antes de inicializar o NVK.

# Perfil de GPU do Switch sem overclock; 0 mantém o padrão do sistema.
switch_gpu_mhz = 460

# Mantenha desativado até que testes confirmem a estabilidade do clock de memória maior.
switch_allow_ram_1600 = false

# 0 mantém a alocação padrão de memória de transferência do libnx. Só aumente
# se o log apontar um erro específico de rastreamento das alocações do NVK.
switch_nvmap_mb = 0

# O NVK informa que a residência esparsa não está disponível nesta versão para Switch.
# Ativar esta opção não evita a alocação integral do buffer compartilhado de 512 MiB do Xenos.
vulkan_sparse_shared_memory = true
